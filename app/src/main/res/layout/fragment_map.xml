<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.RESQ.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/map_title"
        app:menu="@menu/menu_top_level" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/map_accessibility_description" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#F9FAF7"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp"
            app:strokeColor="#E2E7E2"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_map_region"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/map_region_name"
                    android:textColor="#334C46"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/tv_map_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:maxWidth="220dp"
                    android:text="@string/map_status_loading"
                    android:textColor="#65736F"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_map_overview"
            style="@style/Widget.RESQ.MapControl"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:contentDescription="@string/map_show_all"
            android:enabled="false"
            app:icon="@drawable/ic_map_fit" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="76dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_zoom_in"
                style="@style/Widget.RESQ.MapControl"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/map_zoom_in"
                android:enabled="false"
                app:icon="@drawable/ic_map_plus" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_zoom_out"
                style="@style/Widget.RESQ.MapControl"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/map_zoom_out"
                android:enabled="false"
                app:icon="@drawable/ic_map_minus" />
        </LinearLayout>

        <!-- Hazard controls stay dormant until province hazard datasets are added. -->
        <HorizontalScrollView
            android:id="@+id/layer_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_layers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="false" />
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_legend"
            style="@style/Widget.RESQ.CardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/spacing_md"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_legend_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RESQ.Label" />
                <LinearLayout
                    android:id="@+id/layout_legend_rows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#E6F9FAF7"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="@string/map_basemap_attribution"
            android:textColor="#586761"
            android:textSize="10sp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="#4C766B" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/map_error_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#F9FAF7"
            app:cardCornerRadius="16dp"
            app:contentPadding="20dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_map_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/map_load_error"
                    android:textColor="#334C46"
                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_map_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/map_retry" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
