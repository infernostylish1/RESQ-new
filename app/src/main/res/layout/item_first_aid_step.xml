<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:orientation="vertical">

    <!--
        Media placeholder card.
        Visible only when FirstAidContentEntity.mediaResName is non-null.
        Replace this card's contents with an actual ImageView/GifView/VideoView
        once real media assets are available.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_media"
        style="@style/Widget.RESQ.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_variant"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="@dimen/icon_size_xxl"
                android:layout_height="@dimen/icon_size_xxl"
                android:contentDescription="@string/cd_firstaid_icon"
                android:src="@android:drawable/ic_menu_report_image"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_media_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.RESQ.Caption"
                android:textColor="@color/text_secondary"
                tools:text="img_cpr" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Step row: number circle + title/description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_step_number"
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:background="@drawable/bg_step_number_circle"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RESQ.Subtitle"
            android:textColor="@color/on_primary"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_step_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RESQ.Subtitle"
                tools:text="Check for responsiveness" />

            <TextView
                android:id="@+id/tv_step_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.RESQ.Body"
                android:textColor="@color/text_secondary"
                tools:text="Tap the person's shoulder and ask loudly, 'Are you okay?'" />

            <!--
                Warning/tip card.
                Visible when sectionTitle contains "warning" or "important".
                Displays the sectionTitle text as the warning message.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_warning"
                style="@style/Widget.RESQ.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warning_container"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_sm"
                        android:layout_height="@dimen/icon_size_sm"
                        android:contentDescription="@string/firstaid_warning"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/on_warning_container" />

                    <TextView
                        android:id="@+id/tv_warning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RESQ.Caption"
                        android:textColor="@color/on_warning_container"
                        tools:text="Do not move the person if spinal injury is suspected." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>