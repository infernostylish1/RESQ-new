<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_padding">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title - now at the very top -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/onboarding_agreement_title"
                android:textAppearance="@style/TextAppearance.RESQ.Headline" />

            <!-- Description with minimal top spacing -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/onboarding_agreement_desc"
                android:textAppearance="@style/TextAppearance.RESQ.Body"
                android:textColor="@color/text_secondary" />

            <!-- Terms Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_terms"
                style="@style/Widget.RESQ.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/terms_title"
                        android:textAppearance="@style/TextAppearance.RESQ.Subtitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_terms_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.RESQ.BodySmall"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        tools:text="Full terms content here..." />

                    <CheckBox
                        android:id="@+id/cb_terms_accepted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/onboarding_i_accept_terms"
                        android:textAppearance="@style/TextAppearance.RESQ.BodySmall" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Privacy Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_privacy"
                style="@style/Widget.RESQ.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_title"
                        android:textAppearance="@style/TextAppearance.RESQ.Subtitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_privacy_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.RESQ.BodySmall"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        tools:text="Full privacy content here..." />

                    <CheckBox
                        android:id="@+id/cb_privacy_accepted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/onboarding_i_accept_privacy"
                        android:textAppearance="@style/TextAppearance.RESQ.BodySmall" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Small bottom padding for scrolling -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_sm" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>