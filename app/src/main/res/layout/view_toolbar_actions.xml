<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingEnd="@dimen/screen_margin_horizontal">

    <!-- The horizontal group can accommodate additional actions without changing the header. -->
    <LinearLayout
        android:id="@+id/toolbar_actions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_toolbar_actions"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_xs">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_toolbar_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_toolbar_action_ripple"
            android:contentDescription="@string/nav_settings"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/text_primary" />
    </LinearLayout>
</FrameLayout>
