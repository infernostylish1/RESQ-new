<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--values-night-->
    <!-- Base Application Theme - Dark -->
    <style name="Theme.RESQ" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>

        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/nav_background</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">@color/ripple_color</item>

        <!-- Default Widget Styles -->
        <item name="materialCardViewStyle">@style/Widget.RESQ.CardView</item>
        <item name="materialButtonStyle">@style/Widget.RESQ.Button</item>
        <item name="textInputStyle">@style/Widget.RESQ.TextInputLayout</item>

        <!-- Window Attributes -->
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Custom Splash Theme (NO SplashScreen API) -->
    <style name="Theme.RESQ.Splash" parent="Theme.RESQ">
        <!-- Disable the system's default preview window (removes redundant icon) -->
        <item name="android:windowDisablePreview">true</item>
        <!-- Window background shows instantly while layout loads -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <!-- Optional: full screen -->
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Onboarding Theme - Dark -->
    <style name="Theme.RESQ.Onboarding" parent="Theme.RESQ">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

</resources>
