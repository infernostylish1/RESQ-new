<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== CARD STYLES ==================== -->

    <style name="Widget.RESQ" parent="android:Widget" />

    <style name="Widget.RESQ.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="Widget.RESQ.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="Widget.RESQ.CardView.Disaster" parent="Widget.RESQ.CardView.Outlined">
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.RESQ.CardView.Tip" parent="Widget.RESQ.CardView">
        <item name="android:minHeight">@dimen/tip_card_min_height</item>
    </style>

    <!-- ==================== BUTTON STYLES ==================== -->

    <style name="Widget.RESQ.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RESQ.Button.Primary" parent="Widget.RESQ.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.RESQ.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RESQ.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RESQ.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/on_surface</item>
        <item name="iconSize">@dimen/icon_size_md</item>
    </style>

    <style name="Widget.RESQ.Button.Emergency" parent="Widget.RESQ.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/on_error</item>
    </style>

    <style name="Widget.RESQ.Button.Call" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/success</item>
        <item name="iconTint">@color/on_success</item>
        <item name="iconSize">@dimen/icon_size_md</item>
    </style>

    <!-- ==================== FAB STYLES ==================== -->

    <style name="Widget.RESQ.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
    </style>

    <style name="Widget.RESQ.FAB.Voice" parent="Widget.RESQ.FAB">
        <item name="fabSize">normal</item>
    </style>

    <!-- ==================== TEXT INPUT STYLES ==================== -->

    <style name="Widget.RESQ.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="boxStrokeColor">@color/outline</item>
    </style>

    <style name="Widget.RESQ.TextInputLayout.Search" parent="Widget.RESQ.TextInputLayout">
        <item name="boxCornerRadiusTopStart">@dimen/search_bar_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/search_bar_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/search_bar_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/search_bar_corner_radius</item>
        <item name="startIconDrawable">@android:drawable/ic_menu_search</item>
    </style>

    <!-- ==================== TEXT STYLES ==================== -->

    <style name="TextAppearance.RESQ.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_size_display_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontWeight">700</item>
    </style>

    <style name="TextAppearance.RESQ.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontWeight">700</item>
    </style>

    <style name="TextAppearance.RESQ.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.RESQ.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.RESQ.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.RESQ.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.RESQ.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.RESQ.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.RESQ.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.RESQ.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ==================== TOOLBAR STYLES ==================== -->

    <style name="Widget.RESQ.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.RESQ.Headline</item>
        <item name="navigationIconTint">@color/on_surface</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
    </style>

    <style name="Widget.RESQ.Toolbar.Transparent" parent="Widget.RESQ.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ==================== BOTTOM NAVIGATION STYLES ==================== -->

    <style name="Widget.RESQ.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nav_background</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
    </style>

    <!-- ==================== CHIP STYLES ==================== -->

    <style name="Widget.RESQ.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">true</item>
    </style>

    <style name="Widget.RESQ.Chip.Situation" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.RESQ.Chip.Situation.Before" parent="Widget.RESQ.Chip.Situation">
        <item name="chipBackgroundColor">@color/situation_before</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.RESQ.Chip.Situation.During" parent="Widget.RESQ.Chip.Situation">
        <item name="chipBackgroundColor">@color/situation_during</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.RESQ.Chip.Situation.After" parent="Widget.RESQ.Chip.Situation">
        <item name="chipBackgroundColor">@color/situation_after</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- ==================== SWITCH STYLES ==================== -->

    <style name="Widget.RESQ.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <!-- ==================== PROGRESS STYLES ==================== -->

    <style name="Widget.RESQ.ProgressIndicator.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/surface_variant</item>
        <item name="trackCornerRadius">4dp</item>
    </style>

    <style name="Widget.RESQ.ProgressIndicator.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/surface_variant</item>
    </style>

    <!-- ==================== SLIDER STYLES ==================== -->

    <style name="Widget.RESQ.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/primary</item>
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/surface_variant</item>
    </style>

    <!-- ==================== DIVIDER STYLES ==================== -->

    <style name="Widget.RESQ.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- ==================== LIST ITEM STYLES ==================== -->

    <style name="Widget.RESQ.ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_item_height</item>
        <item name="android:paddingStart">@dimen/list_item_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/list_item_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/list_item_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/list_item_padding_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- ==================== DIALOG STYLES ==================== -->

    <style name="ThemeOverlay.RESQ.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Widget.RESQ.AlertDialog</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
    </style>

    <style name="Widget.RESQ.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.RESQ.Dialog</item>
    </style>

    <style name="ShapeAppearance.RESQ.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
    </style>

</resources>