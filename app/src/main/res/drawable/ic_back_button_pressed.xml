<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Circle background - darker when pressed -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/nav_selected" />
            <size
                android:width="40dp"
                android:height="40dp" />
        </shape>
    </item>

    <!-- Arrow icon centered inside the circle - white when pressed -->
    <item
        android:drawable="@drawable/ic_arrow_back"
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp" />

</layer-list>