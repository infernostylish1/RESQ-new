    <!-- About -->
    <string name="about_title">Tungkol sa RESQ</string>
    <string name="about_description">Ang RESQ ay isang offline disaster preparedness application na idinisenyo upang magbigay ng accessible at maaasahang impormasyon upang matulungan ang mga indibidwal na tumugon nang epektibo sa mga emergency situation.</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer">Ang application na ito ay para sa mga layuning pang-edukasyon lamang. Ang impormasyong ibinibigay ay hindi dapat palitan ang propesyonal na payo medikal, mga serbisyo sa emergency, o opisyal na mga protocol sa pagtugon sa sakuna. Laging sundin ang mga tagubilin ng mga lokal na awtoridad sa mga emergency.</string>
    <string name="about_developed_by">Ginawa para sa mga layuning pang-edukasyon</string>
